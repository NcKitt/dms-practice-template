# คัดลอกเป็น .env เพื่อรันในเครื่อง (npm run dev)  — ห้าม commit ไฟล์ .env
PORT=3000
APP_TITLE=บอร์ดประกาศหน่วยงาน
# local | docker | pm2 — แสดงที่ /api/health เพื่อให้รู้ว่ากำลังดูแอปตัวไหนอยู่
DEPLOY_TARGET=local
# เว้นว่าง = เก็บข้อมูลใน memory (หายเมื่อรีสตาร์ท) | ใส่ path = บันทึกลงไฟล์ JSON
DATA_FILE=
